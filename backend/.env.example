# Local development defaults (copy to backend/.env). Production values are set in Railway.
DATABASE_URL=postgresql+psycopg://postgres@localhost:5432/hitfar
APP_PASSWORD=changeme
SECRET_KEY=change-me-to-a-long-random-string
COOKIE_SECURE=false

# local = files on disk (dev); s3 = Railway Bucket / R2 / S3
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./.data/storage
# S3_ENDPOINT_URL=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto
# S3_ADDRESSING_STYLE=virtual
# PUBLIC_ORIGIN=https://your-app.up.railway.app   # bucket CORS for browser uploads

GOLFER_HANDEDNESS=right
ANTHROPIC_API_KEY=
